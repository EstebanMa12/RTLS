# Copy to Backend/.env and replace the placeholders.
# Do not commit Backend/.env.

PORT=4000
API_VERSION_ROUTE=/api/v1
NODE_ENV=development

# Local MongoDB from the root docker-compose.yml:
MONGO_DB_URI=mongodb://127.0.0.1:27017/smtr
# Atlas example (use your own user, password, and cluster):
# MONGO_DB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/smtr?retryWrites=true&w=majority
